{
  "name": "ceramic-commerce-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Full-stack ceramic store management and e-commerce system.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:client": "npm run dev:frontend",
    "dev:server": "npm run dev:backend",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "prisma:generate": "prisma generate --schema=database/prisma/schema.prisma && prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=database/prisma/schema.prisma",
    "seed": "node database/seed.js"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
